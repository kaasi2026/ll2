{
	"name": "web",
	"description": "A web app for learning with LibreLingo courses",
	"version": "1.33.0",
	"type": "module",
	"private": true,
	"scripts": {
		"prepareCourses": "node ./scripts/prepareCourses.js",
		"predev": "npm run prepareCourses",
		"prebuild": "npm run prepareCourses",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"types": "tsc && svelte-check --treshold error",
		"installCourse": "./scripts/installExternalCourse.sh",
		"installAllExternalCourses": "python ./scripts/installExternalCourses.py",
		"installSelectedCourses": "python ./scripts/installCustomCourses.py",
		"fetchAudios": "bash ./scripts/fetchAudios.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/howler": "^2.2.12",
		"@types/js-cookie": "^3.0.6",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^22.10.7",
		"@types/sortablejs": "^1.15.8",
		"sass": "^1.83.4",
		"svelte": "^5.0.0",
		"svelte-check": "^4.6.0",
		"vite-plugin-markdown": "^2.2.0"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^6.7.2",
		"answer-corrector": "*",
		"bulma": "^0.9.4",
		"bulmaswatch": "^0.8.1",
		"dayjs": "^1.11.23",
		"hotkeys-js": "^3.13.9",
		"howler": "^2.2.4",
		"js-cookie": "^3.0.5",
		"leven": "^4.0.0",
		"markdown-it": "^15.0.2",
		"pouchdb": "^9.0.0",
		"sortablejs": "^1.15.6"
	}
}
